{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "bash tool/vercel-build.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://unlabel-india-catalogue.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://unlabel-india-catalogue.firebaseapp.com/__/firebase/init.json"
    }
  ],
  "headers": [
    {
      "source": "/__/auth/:path*",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/__/firebase/init.json",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/ocr/lang/:path*",
      "headers": [
        {"key": "Content-Type", "value": "application/octet-stream"},
        {"key": "Content-Disposition", "value": "inline"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    }
  ]
}
