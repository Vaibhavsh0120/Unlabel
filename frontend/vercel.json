{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "bash tool/vercel-build.sh",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://unlabel-india-catalogue.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://unlabel-india-catalogue.firebaseapp.com/__/firebase/init.json"
    }
  ],
  "headers": [
    {
      "source": "/auth-callback(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"}
      ]
    },
    {
      "source": "/account-(recovery|confirmation)(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src https://unlabel.duckdns.org; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"}
      ]
    },
    {
      "source": "/__/auth/:path*",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/__/firebase/init.json",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"}
      ]
    },
    {
      "source": "/ocr/lang/:path*",
      "headers": [
        {"key": "Content-Type", "value": "application/octet-stream"},
        {"key": "Content-Disposition", "value": "inline"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    }
  ]
}
