* text=auto
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.dart text eol=lf
*.json text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.lock text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.age binary
*.gz binary
# Preserve vendored OCR and font-license bytes for their recorded source hashes.
frontend/web/ocr/** -text
frontend/web/ocr/provenance.json text eol=lf
frontend/web/ocr/licenses/* -whitespace
frontend/assets/brand/fonts/CormorantGaramond-OFL.txt -text -whitespace
frontend/assets/brand/fonts/Quicksand-OFL.txt -text -whitespace
# Preserve downloaded decoder bytes for recorded hashes; normalize our manifest.
frontend/web/vendor/** -text
frontend/web/vendor/zxing-wasm/3.1.3/provenance.json text eol=lf
frontend/web/vendor/zxing-wasm/3.1.3/LICENSE -whitespace
frontend/web/vendor/zxing-wasm/3.1.3/ZXING_CPP_LICENSE -whitespace
