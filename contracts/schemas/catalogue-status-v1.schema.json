{
  "$defs": {
    "CatalogueArtifact": {
      "additionalProperties": false,
      "properties": {
        "database_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Database Sha256",
          "type": "string"
        },
        "database_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 104857600,
          "title": "Database Bytes",
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "database_sha256",
        "database_bytes",
        "source_sha256",
        "snapshot_id"
      ],
      "title": "CatalogueArtifact",
      "type": "object"
    },
    "Manifest": {
      "additionalProperties": false,
      "description": "Source SHA-256 covers every decoded byte of the local import input, through EOF.\n\n``unverified`` does not assert independent completeness of products sold in India.\nA CSV projection has separate upstream acquisition proof outside this contract.",
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "source_format": {
          "default": "off_jsonl",
          "enum": [
            "off_jsonl",
            "off_csv_projection"
          ],
          "title": "Source Format",
          "type": "string"
        },
        "coverage": {
          "default": "sample",
          "enum": [
            "sample",
            "unverified"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "exported_at": {
          "format": "date-time",
          "title": "Exported At",
          "type": "string"
        },
        "indexed_at": {
          "format": "date-time",
          "title": "Indexed At",
          "type": "string"
        },
        "market_tag": {
          "const": "en:india",
          "default": "en:india",
          "title": "Market Tag",
          "type": "string"
        },
        "rows_read": {
          "minimum": 0,
          "title": "Rows Read",
          "type": "integer"
        },
        "india_rows": {
          "minimum": 0,
          "title": "India Rows",
          "type": "integer"
        },
        "indexed_products": {
          "minimum": 1,
          "title": "Indexed Products",
          "type": "integer"
        },
        "duplicate_barcodes": {
          "default": 0,
          "minimum": 0,
          "title": "Duplicate Barcodes",
          "type": "integer"
        },
        "unsupported_barcodes": {
          "minimum": 0,
          "title": "Unsupported Barcodes",
          "type": "integer"
        },
        "missing_name": {
          "minimum": 0,
          "title": "Missing Name",
          "type": "integer"
        },
        "missing_ingredients": {
          "minimum": 0,
          "title": "Missing Ingredients",
          "type": "integer"
        },
        "database_license": {
          "const": "ODbL-1.0",
          "default": "ODbL-1.0",
          "title": "Database License",
          "type": "string"
        },
        "contents_license": {
          "const": "DbCL-1.0",
          "default": "DbCL-1.0",
          "title": "Contents License",
          "type": "string"
        },
        "attribution": {
          "const": "Product data from Open Food Facts",
          "default": "Product data from Open Food Facts",
          "title": "Attribution",
          "type": "string"
        },
        "license_url": {
          "const": "https://openfoodfacts.org/terms-of-use",
          "default": "https://openfoodfacts.org/terms-of-use",
          "title": "License Url",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "source_url",
        "source_sha256",
        "exported_at",
        "indexed_at",
        "rows_read",
        "india_rows",
        "indexed_products",
        "unsupported_barcodes",
        "missing_name",
        "missing_ingredients"
      ],
      "title": "Manifest",
      "type": "object"
    },
    "SnapshotFreshness": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "within_refresh_window",
            "refresh_due",
            "source_date_in_future"
          ],
          "title": "Status",
          "type": "string"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "age_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Age Seconds"
        },
        "refresh_due_at": {
          "format": "date-time",
          "title": "Refresh Due At",
          "type": "string"
        },
        "refresh_interval_months": {
          "const": 9,
          "default": 9,
          "title": "Refresh Interval Months",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "evaluated_at",
        "age_seconds",
        "refresh_due_at"
      ],
      "title": "SnapshotFreshness",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "not_configured",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/Manifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "freshness": {
      "anyOf": [
        {
          "$ref": "#/$defs/SnapshotFreshness"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/CatalogueArtifact"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "data_kind": {
      "const": "product_identity",
      "default": "product_identity",
      "title": "Data Kind",
      "type": "string"
    },
    "field_limits": {
      "items": {
        "type": "string"
      },
      "title": "Field Limits",
      "type": "array"
    }
  },
  "required": [
    "status"
  ],
  "title": "CatalogueStatus",
  "type": "object"
}
