{
  "$defs": {
    "NutrientCell": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "g",
            "kcal"
          ],
          "title": "Unit",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "not_reported",
                "unknown_value",
                "conflicting_values",
                "conversion_missing_basis",
                "conversion_out_of_bounds"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "source_row_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Source Row Ids",
          "type": "array"
        },
        "conversion": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversion"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "NutrientCell",
      "type": "object"
    },
    "NutrientRow": {
      "additionalProperties": false,
      "properties": {
        "row_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Row Id",
          "type": "string"
        },
        "table_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Table Id",
          "type": "string"
        },
        "nutrient": {
          "enum": [
            "energy",
            "fat",
            "saturated_fat",
            "carbohydrates",
            "carbohydrates_total",
            "sugars",
            "added_sugars",
            "fibre",
            "protein",
            "sodium",
            "salt"
          ],
          "title": "Nutrient",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "g",
            "mg",
            "ug",
            "kcal",
            "kJ"
          ],
          "title": "Unit",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/NutritionBasis"
        },
        "preparation": {
          "enum": [
            "as_sold",
            "as_prepared"
          ],
          "title": "Preparation",
          "type": "string"
        }
      },
      "required": [
        "row_id",
        "table_id",
        "nutrient",
        "value",
        "unit",
        "basis",
        "preparation"
      ],
      "title": "NutrientRow",
      "type": "object"
    },
    "NutritionBasis": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "quantity",
            "serving"
          ],
          "title": "Kind",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "g",
                "mL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NutritionBasis",
      "type": "object"
    },
    "NutritionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "normalization_version": {
          "const": "1",
          "default": "1",
          "title": "Normalization Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "needs_correction"
          ],
          "title": "Status",
          "type": "string"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/NutritionTable"
          },
          "maxItems": 64,
          "title": "Tables",
          "type": "array"
        },
        "original_rows": {
          "items": {
            "$ref": "#/$defs/NutrientRow"
          },
          "maxItems": 64,
          "title": "Original Rows",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "NutritionSnapshot",
      "type": "object"
    },
    "NutritionTable": {
      "additionalProperties": false,
      "properties": {
        "source_table_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Table Id",
          "type": "string"
        },
        "preparation": {
          "enum": [
            "as_sold",
            "as_prepared"
          ],
          "title": "Preparation",
          "type": "string"
        },
        "original_basis": {
          "$ref": "#/$defs/NutritionBasis"
        },
        "normalized_basis": {
          "$ref": "#/$defs/NutritionBasis"
        },
        "nutrients": {
          "additionalProperties": {
            "$ref": "#/$defs/NutrientCell"
          },
          "propertyNames": {
            "enum": [
              "energy",
              "fat",
              "saturated_fat",
              "carbohydrates",
              "carbohydrates_total",
              "sugars",
              "added_sugars",
              "fibre",
              "protein",
              "sodium",
              "salt"
            ]
          },
          "title": "Nutrients",
          "type": "object"
        }
      },
      "required": [
        "source_table_id",
        "preparation",
        "original_basis",
        "normalized_basis",
        "nutrients"
      ],
      "title": "NutritionTable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "client_request_id": {
      "format": "uuid",
      "title": "Client Request Id",
      "type": "string"
    },
    "capture_session_id": {
      "format": "uuid",
      "title": "Capture Session Id",
      "type": "string"
    },
    "input_revision": {
      "title": "Input Revision",
      "type": "integer"
    },
    "normalized_at": {
      "format": "date-time",
      "title": "Normalized At",
      "type": "string"
    },
    "assessment_basis": {
      "const": "user_confirmed_label",
      "default": "user_confirmed_label",
      "title": "Assessment Basis",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/NutritionSnapshot"
    }
  },
  "required": [
    "client_request_id",
    "capture_session_id",
    "input_revision",
    "normalized_at",
    "snapshot"
  ],
  "title": "NormalizeResponse",
  "type": "object"
}
