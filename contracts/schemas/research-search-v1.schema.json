{
  "$defs": {
    "ResearchCandidate": {
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Entry Id",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/ResearchIdentity"
        },
        "provider": {
          "enum": [
            "open_food_facts",
            "manufacturer",
            "retailer"
          ],
          "title": "Provider",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ResearchSource"
        },
        "eligibility": {
          "enum": [
            "exact_sku",
            "brand_family_only",
            "identity_unconfirmed",
            "conflicting"
          ],
          "title": "Eligibility",
          "type": "string"
        },
        "conflict_fields": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Conflict Fields",
          "type": "array"
        },
        "ingredients_available": {
          "title": "Ingredients Available",
          "type": "boolean"
        },
        "nutrition_available": {
          "title": "Nutrition Available",
          "type": "boolean"
        }
      },
      "required": [
        "entry_id",
        "identity",
        "provider",
        "source",
        "eligibility",
        "ingredients_available",
        "nutrition_available"
      ],
      "title": "ResearchCandidate",
      "type": "object"
    },
    "ResearchIdentity": {
      "additionalProperties": false,
      "properties": {
        "barcode": {
          "anyOf": [
            {
              "pattern": "^(?:[0-9]{8}|[0-9]{12,14})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Barcode"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "brand": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Brand"
        },
        "variant": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Variant"
        },
        "quantity": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity"
        },
        "market": {
          "enum": [
            "india",
            "unknown"
          ],
          "title": "Market",
          "type": "string"
        },
        "match": {
          "enum": [
            "exact_sku",
            "brand_family_only",
            "identity_unconfirmed"
          ],
          "title": "Match",
          "type": "string"
        },
        "barcode_evidence_url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Barcode Evidence Url"
        }
      },
      "required": [
        "barcode",
        "name",
        "brand",
        "variant",
        "quantity",
        "market",
        "match",
        "barcode_evidence_url"
      ],
      "title": "ResearchIdentity",
      "type": "object"
    },
    "ResearchLicense": {
      "additionalProperties": false,
      "properties": {
        "database": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Database"
        },
        "contents": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Contents"
        },
        "images": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Images"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        },
        "reuse_status": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Reuse Status",
          "type": "string"
        }
      },
      "required": [
        "database",
        "contents",
        "images",
        "note",
        "reuse_status"
      ],
      "title": "ResearchLicense",
      "type": "object"
    },
    "ResearchSource": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "open_food_facts",
            "manufacturer",
            "retailer"
          ],
          "title": "Provider",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "retrieved_at": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Retrieved At",
          "type": "string"
        },
        "source_updated_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Updated At"
        },
        "license": {
          "$ref": "#/$defs/ResearchLicense"
        }
      },
      "required": [
        "provider",
        "url",
        "retrieved_at",
        "source_updated_at",
        "license"
      ],
      "title": "ResearchSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "search_version": {
      "const": "research-search-v1",
      "default": "research-search-v1",
      "title": "Search Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "not_found",
        "unavailable",
        "refine_query"
      ],
      "title": "Status",
      "type": "string"
    },
    "dataset_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dataset Sha256"
    },
    "query": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "normalized_query": {
      "maxLength": 519,
      "minLength": 1,
      "title": "Normalized Query",
      "type": "string"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ResearchCandidate"
      },
      "maxItems": 20,
      "title": "Candidates",
      "type": "array"
    },
    "matched_count": {
      "anyOf": [
        {
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Matched Count"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "warnings": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status",
    "dataset_sha256",
    "query",
    "normalized_query"
  ],
  "title": "ResearchSearchResult",
  "type": "object"
}
