{
  "$defs": {
    "CommunityRevision": {
      "additionalProperties": false,
      "properties": {
        "revision_id": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revision Id",
          "type": "string"
        },
        "content_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "factual_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Factual Sha256",
          "type": "string"
        },
        "barcode": {
          "maxLength": 14,
          "minLength": 8,
          "title": "Barcode",
          "type": "string"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reviewed At"
        },
        "facts": {
          "$ref": "#/$defs/ContributionFacts"
        },
        "snapshot": {
          "$ref": "#/$defs/NutritionSnapshot"
        },
        "origin": {
          "const": "unlabel_community",
          "default": "unlabel_community",
          "title": "Origin",
          "type": "string"
        },
        "license": {
          "const": "CC0-1.0",
          "default": "CC0-1.0",
          "title": "License",
          "type": "string"
        },
        "review_state": {
          "default": "moderator_accepted_community_assertion",
          "enum": [
            "moderator_accepted_community_assertion",
            "submitter_confirmed_not_moderator_reviewed"
          ],
          "title": "Review State",
          "type": "string"
        }
      },
      "required": [
        "revision_id",
        "content_sha256",
        "factual_sha256",
        "barcode",
        "submitted_at",
        "reviewed_at",
        "facts",
        "snapshot"
      ],
      "title": "CommunityRevision",
      "type": "object"
    },
    "ContributionFacts": {
      "additionalProperties": false,
      "description": "Public factual assertion; permission/ownership/request IDs are not exposed.",
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "barcode": {
          "anyOf": [
            {
              "maxLength": 14,
              "minLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Barcode"
        },
        "identity": {
          "$ref": "#/$defs/ProductIdentity"
        },
        "ingredients": {
          "$ref": "#/$defs/LabelSection"
        },
        "contains": {
          "$ref": "#/$defs/LabelSection"
        },
        "may_contain": {
          "$ref": "#/$defs/LabelSection"
        },
        "front_claims": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Front Claims",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/NutrientRow"
          },
          "maxItems": 64,
          "title": "Rows",
          "type": "array"
        },
        "nutrition_completeness": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Nutrition Completeness",
          "type": "string"
        },
        "nutrition_origin": {
          "const": "independently_transcribed_package",
          "title": "Nutrition Origin",
          "type": "string"
        },
        "provider_references": {
          "items": {
            "$ref": "#/$defs/ProviderReference"
          },
          "maxItems": 8,
          "title": "Provider References",
          "type": "array"
        },
        "revision_context": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Context"
        },
        "observed_on": {
          "format": "date",
          "title": "Observed On",
          "type": "string"
        },
        "capture_method": {
          "enum": [
            "manual",
            "ocr_corrected",
            "ocr_unconfirmed"
          ],
          "title": "Capture Method",
          "type": "string"
        },
        "share_license": {
          "const": "CC0-1.0",
          "title": "Share License",
          "type": "string"
        },
        "market": {
          "const": "india",
          "title": "Market",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "ingredients",
        "contains",
        "may_contain",
        "nutrition_completeness",
        "nutrition_origin",
        "observed_on",
        "capture_method",
        "share_license",
        "market"
      ],
      "title": "ContributionFacts",
      "type": "object"
    },
    "LabelSection": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "present",
            "not_observed",
            "not_captured"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 16000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "origin": {
          "const": "independently_transcribed_package",
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "status",
        "text",
        "completeness",
        "origin"
      ],
      "title": "LabelSection",
      "type": "object"
    },
    "NutrientCell": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "g",
            "kcal"
          ],
          "title": "Unit",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "not_reported",
                "unknown_value",
                "conflicting_values",
                "conversion_missing_basis",
                "conversion_out_of_bounds"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "source_row_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Source Row Ids",
          "type": "array"
        },
        "conversion": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversion"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "NutrientCell",
      "type": "object"
    },
    "NutrientRow": {
      "additionalProperties": false,
      "properties": {
        "row_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Row Id",
          "type": "string"
        },
        "table_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Table Id",
          "type": "string"
        },
        "nutrient": {
          "enum": [
            "energy",
            "fat",
            "saturated_fat",
            "carbohydrates",
            "carbohydrates_total",
            "sugars",
            "added_sugars",
            "fibre",
            "protein",
            "sodium",
            "salt"
          ],
          "title": "Nutrient",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "g",
            "mg",
            "ug",
            "kcal",
            "kJ"
          ],
          "title": "Unit",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/NutritionBasis"
        },
        "preparation": {
          "enum": [
            "as_sold",
            "as_prepared"
          ],
          "title": "Preparation",
          "type": "string"
        }
      },
      "required": [
        "row_id",
        "table_id",
        "nutrient",
        "value",
        "unit",
        "basis",
        "preparation"
      ],
      "title": "NutrientRow",
      "type": "object"
    },
    "NutritionBasis": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "quantity",
            "serving"
          ],
          "title": "Kind",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "g",
                "mL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NutritionBasis",
      "type": "object"
    },
    "NutritionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "normalization_version": {
          "const": "1",
          "default": "1",
          "title": "Normalization Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "needs_correction"
          ],
          "title": "Status",
          "type": "string"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/NutritionTable"
          },
          "maxItems": 64,
          "title": "Tables",
          "type": "array"
        },
        "original_rows": {
          "items": {
            "$ref": "#/$defs/NutrientRow"
          },
          "maxItems": 64,
          "title": "Original Rows",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "NutritionSnapshot",
      "type": "object"
    },
    "NutritionTable": {
      "additionalProperties": false,
      "properties": {
        "source_table_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Table Id",
          "type": "string"
        },
        "preparation": {
          "enum": [
            "as_sold",
            "as_prepared"
          ],
          "title": "Preparation",
          "type": "string"
        },
        "original_basis": {
          "$ref": "#/$defs/NutritionBasis"
        },
        "normalized_basis": {
          "$ref": "#/$defs/NutritionBasis"
        },
        "nutrients": {
          "additionalProperties": {
            "$ref": "#/$defs/NutrientCell"
          },
          "propertyNames": {
            "enum": [
              "energy",
              "fat",
              "saturated_fat",
              "carbohydrates",
              "carbohydrates_total",
              "sugars",
              "added_sugars",
              "fibre",
              "protein",
              "sodium",
              "salt"
            ]
          },
          "title": "Nutrients",
          "type": "object"
        }
      },
      "required": [
        "source_table_id",
        "preparation",
        "original_basis",
        "normalized_basis",
        "nutrients"
      ],
      "title": "NutritionTable",
      "type": "object"
    },
    "ProductIdentity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "brand": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brand"
        },
        "variant": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant"
        },
        "quantity": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantity"
        },
        "language": {
          "maxLength": 3,
          "minLength": 2,
          "pattern": "^[a-z]{2,3}$",
          "title": "Language",
          "type": "string"
        }
      },
      "required": [
        "name",
        "language"
      ],
      "title": "ProductIdentity",
      "type": "object"
    },
    "ProviderReference": {
      "additionalProperties": false,
      "description": "Pointers to existing licensed data, never a copied CC0 assertion.",
      "properties": {
        "provider": {
          "const": "off_snapshot",
          "title": "Provider",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "barcode": {
          "maxLength": 14,
          "minLength": 8,
          "title": "Barcode",
          "type": "string"
        },
        "fields": {
          "items": {
            "enum": [
              "identity.name",
              "identity.brand",
              "identity.variant",
              "identity.quantity",
              "ingredients",
              "contains",
              "may_contain",
              "nutrition"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "provider",
        "source_id",
        "barcode",
        "fields"
      ],
      "title": "ProviderReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "requested_barcode": {
      "maxLength": 14,
      "minLength": 8,
      "title": "Requested Barcode",
      "type": "string"
    },
    "status": {
      "enum": [
        "found",
        "not_found",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "revisions": {
      "items": {
        "$ref": "#/$defs/CommunityRevision"
      },
      "maxItems": 8,
      "title": "Revisions",
      "type": "array"
    },
    "warnings": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "requested_barcode",
    "status"
  ],
  "title": "CommunityLookup",
  "type": "object"
}
