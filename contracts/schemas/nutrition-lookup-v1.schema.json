{
  "$defs": {
    "InputTableSource": {
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "title": "Table Id",
          "type": "string"
        },
        "provider_source": {
          "enum": [
            "packaging",
            "manufacturer"
          ],
          "title": "Provider Source",
          "type": "string"
        }
      },
      "required": [
        "table_id",
        "provider_source"
      ],
      "title": "InputTableSource",
      "type": "object"
    },
    "NutrientCell": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "g",
            "kcal"
          ],
          "title": "Unit",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "not_reported",
                "unknown_value",
                "conflicting_values",
                "conversion_missing_basis",
                "conversion_out_of_bounds"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "source_row_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Source Row Ids",
          "type": "array"
        },
        "conversion": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversion"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "NutrientCell",
      "type": "object"
    },
    "NutrientRow": {
      "additionalProperties": false,
      "properties": {
        "row_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Row Id",
          "type": "string"
        },
        "table_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Table Id",
          "type": "string"
        },
        "nutrient": {
          "enum": [
            "energy",
            "fat",
            "saturated_fat",
            "carbohydrates",
            "carbohydrates_total",
            "sugars",
            "added_sugars",
            "fibre",
            "protein",
            "sodium",
            "salt"
          ],
          "title": "Nutrient",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1000000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "enum": [
            "g",
            "mg",
            "ug",
            "kcal",
            "kJ"
          ],
          "title": "Unit",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/NutritionBasis"
        },
        "preparation": {
          "enum": [
            "as_sold",
            "as_prepared"
          ],
          "title": "Preparation",
          "type": "string"
        }
      },
      "required": [
        "row_id",
        "table_id",
        "nutrient",
        "value",
        "unit",
        "basis",
        "preparation"
      ],
      "title": "NutrientRow",
      "type": "object"
    },
    "NutritionBasis": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "quantity",
            "serving"
          ],
          "title": "Kind",
          "type": "string"
        },
        "amount": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amount"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "g",
                "mL"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NutritionBasis",
      "type": "object"
    },
    "NutritionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "normalization_version": {
          "const": "1",
          "default": "1",
          "title": "Normalization Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "needs_correction"
          ],
          "title": "Status",
          "type": "string"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/NutritionTable"
          },
          "maxItems": 64,
          "title": "Tables",
          "type": "array"
        },
        "original_rows": {
          "items": {
            "$ref": "#/$defs/NutrientRow"
          },
          "maxItems": 64,
          "title": "Original Rows",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "NutritionSnapshot",
      "type": "object"
    },
    "NutritionTable": {
      "additionalProperties": false,
      "properties": {
        "source_table_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Table Id",
          "type": "string"
        },
        "preparation": {
          "enum": [
            "as_sold",
            "as_prepared"
          ],
          "title": "Preparation",
          "type": "string"
        },
        "original_basis": {
          "$ref": "#/$defs/NutritionBasis"
        },
        "normalized_basis": {
          "$ref": "#/$defs/NutritionBasis"
        },
        "nutrients": {
          "additionalProperties": {
            "$ref": "#/$defs/NutrientCell"
          },
          "propertyNames": {
            "enum": [
              "energy",
              "fat",
              "saturated_fat",
              "carbohydrates",
              "carbohydrates_total",
              "sugars",
              "added_sugars",
              "fibre",
              "protein",
              "sodium",
              "salt"
            ]
          },
          "title": "Nutrients",
          "type": "object"
        }
      },
      "required": [
        "source_table_id",
        "preparation",
        "original_basis",
        "normalized_basis",
        "nutrients"
      ],
      "title": "NutritionTable",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "open_food_facts",
          "default": "open_food_facts",
          "title": "Provider",
          "type": "string"
        },
        "upstream_api_version": {
          "const": "3.6",
          "default": "3.6",
          "title": "Upstream Api Version",
          "type": "string"
        },
        "adapter_version": {
          "const": "1",
          "default": "1",
          "title": "Adapter Version",
          "type": "string"
        },
        "product_url": {
          "title": "Product Url",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "provider_modified_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Modified At"
        },
        "provider_schema_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Schema Version"
        },
        "attribution": {
          "default": "Product data from Open Food Facts",
          "title": "Attribution",
          "type": "string"
        },
        "database_license": {
          "const": "ODbL-1.0",
          "default": "ODbL-1.0",
          "title": "Database License",
          "type": "string"
        },
        "contents_license": {
          "const": "DbCL-1.0",
          "default": "DbCL-1.0",
          "title": "Contents License",
          "type": "string"
        },
        "license_url": {
          "default": "https://openfoodfacts.org/terms-of-use",
          "title": "License Url",
          "type": "string"
        }
      },
      "required": [
        "product_url",
        "retrieved_at"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "nutrition_adapter_version": {
      "const": "1",
      "default": "1",
      "title": "Nutrition Adapter Version",
      "type": "string"
    },
    "requested_barcode": {
      "title": "Requested Barcode",
      "type": "string"
    },
    "product_barcode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Product Barcode"
    },
    "status": {
      "enum": [
        "found",
        "not_found",
        "rate_limited",
        "unavailable",
        "incompatible_response"
      ],
      "title": "Status",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "assessment_basis": {
      "const": "open_food_facts_community_data",
      "default": "open_food_facts_community_data",
      "title": "Assessment Basis",
      "type": "string"
    },
    "input_tables": {
      "items": {
        "$ref": "#/$defs/InputTableSource"
      },
      "title": "Input Tables",
      "type": "array"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/NutritionSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "requested_barcode",
    "status",
    "source"
  ],
  "title": "NutritionLookup",
  "type": "object"
}
