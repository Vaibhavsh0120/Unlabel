        "properties": {
          "normalization_version": {
            "type": "string",
            "const": "1",
            "title": "Normalization Version",
            "default": "1"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "needs_correction"
            ],
            "title": "Status"
          },
          "tables": {
            "items": {
              "$ref": "#/components/schemas/NutritionTable"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Tables"
          },
          "original_rows": {
            "items": {
              "$ref": "#/components/schemas/NutrientRow"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Original Rows"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
