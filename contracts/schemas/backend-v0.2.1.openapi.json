  "components": {
    "schemas": {
      "CatalogLookup": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version",
            "default": "1"
          },
          "requested_barcode": {
            "type": "string",
            "pattern": "^(?:[0-9]{8}|[0-9]{12,14})$",
            "title": "Requested Barcode"
          },
          "status": {
            "type": "string",
            "enum": [
              "found",
              "not_found",
              "unavailable"
            ],
            "title": "Status"
          },
          "manifest": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Manifest"
              },
              {
                "type": "null"
              }
            ]
          },
          "product": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Product"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requested_barcode",
          "status"
        ],
        "title": "CatalogLookup"
      },
      "InputTableSource": {
        "properties": {
          "table_id": {
            "type": "string",
            "title": "Table Id"
          },
          "provider_source": {
            "type": "string",
            "enum": [
              "packaging",
              "manufacturer"
            ],
            "title": "Provider Source"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "table_id",
          "provider_source"
        ],
        "title": "InputTableSource"
      },
      "Manifest": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version",
            "default": "1"
          },
          "snapshot_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Snapshot Id"
          },
          "source_url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Source Url"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Source Sha256"
          },
          "source_format": {
            "type": "string",
            "enum": [
              "off_jsonl",
              "off_csv_projection"
            ],
            "title": "Source Format",
            "default": "off_jsonl"
          },
          "coverage": {
            "type": "string",
            "enum": [
              "sample",
              "unverified"
            ],
            "title": "Coverage",
            "default": "sample"
          },
          "exported_at": {
            "type": "string",
            "format": "date-time",
            "title": "Exported At"
          },
          "indexed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Indexed At"
          },
          "market_tag": {
            "type": "string",
            "const": "en:india",
            "title": "Market Tag",
            "default": "en:india"
          },
          "rows_read": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Rows Read"
          },
          "india_rows": {
            "type": "integer",
            "minimum": 0.0,
            "title": "India Rows"
          },
          "indexed_products": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Indexed Products"
          },
          "duplicate_barcodes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Duplicate Barcodes",
            "default": 0
          },
          "unsupported_barcodes": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Unsupported Barcodes"
          },
          "missing_name": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Missing Name"
          },
          "missing_ingredients": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Missing Ingredients"
          },
          "database_license": {
            "type": "string",
            "const": "ODbL-1.0",
            "title": "Database License",
            "default": "ODbL-1.0"
          },
          "contents_license": {
            "type": "string",
            "const": "DbCL-1.0",
            "title": "Contents License",
            "default": "DbCL-1.0"
          },
          "attribution": {
            "type": "string",
            "const": "Product data from Open Food Facts",
            "title": "Attribution",
            "default": "Product data from Open Food Facts"
          },
          "license_url": {
            "type": "string",
            "const": "https://openfoodfacts.org/terms-of-use",
            "title": "License Url",
            "default": "https://openfoodfacts.org/terms-of-use"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "snapshot_id",
          "source_url",
          "source_sha256",
          "exported_at",
          "indexed_at",
          "rows_read",
          "india_rows",
          "indexed_products",
          "unsupported_barcodes",
          "missing_name",
          "missing_ingredients"
        ],
        "title": "Manifest",
        "description": "Source SHA-256 covers every decoded byte of the local import input, through EOF.\n\n``unverified`` does not assert independent completeness of products sold in India.\nA CSV projection has separate upstream acquisition proof outside this contract."
      },
      "NormalizeRequest": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version",
            "default": "1"
          },
          "client_request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Request Id"
          },
          "capture_session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Capture Session Id"
          },
          "input_revision": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Input Revision"
          },
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed"
          },
          "completeness": {
            "type": "string",
            "enum": [
              "complete",
              "partial"
            ],
            "title": "Completeness"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/NutrientRow"
            },
            "type": "array",
            "maxItems": 64,
            "minItems": 1,
            "title": "Rows"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_request_id",
          "capture_session_id",
          "input_revision",
          "confirmed",
          "completeness",
          "rows"
        ],
        "title": "NormalizeRequest"
      },
      "NormalizeResponse": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version",
            "default": "1"
          },
          "client_request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Request Id"
          },
          "capture_session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Capture Session Id"
          },
          "input_revision": {
            "type": "integer",
            "title": "Input Revision"
          },
          "normalized_at": {
            "type": "string",
            "format": "date-time",
            "title": "Normalized At"
          },
          "assessment_basis": {
            "type": "string",
            "const": "user_confirmed_label",
            "title": "Assessment Basis",
            "default": "user_confirmed_label"
          },
          "snapshot": {
            "$ref": "#/components/schemas/NutritionSnapshot"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "client_request_id",
          "capture_session_id",
          "input_revision",
          "normalized_at",
          "snapshot"
        ],
        "title": "NormalizeResponse"
      },
      "NutrientCell": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "enum": [
              "g",
              "kcal"
            ],
            "title": "Unit"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "not_reported",
                  "unknown_value",
                  "conflicting_values",
                  "conversion_missing_basis",
                  "conversion_out_of_bounds"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "source_row_ids": {
            "items": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Source Row Ids"
          },
          "conversion": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversion"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "unit"
        ],
        "title": "NutrientCell"
      },
      "NutrientRow": {
        "properties": {
          "row_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Row Id"
          },
          "table_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "title": "Table Id"
          },
          "nutrient": {
            "type": "string",
            "enum": [
              "energy",
              "fat",
              "saturated_fat",
              "carbohydrates",
              "carbohydrates_total",
              "sugars",
              "added_sugars",
              "fibre",
              "protein",
              "sodium",
              "salt"
            ],
            "title": "Nutrient"
          },
          "value": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "enum": [
              "g",
              "mg",
              "ug",
              "kcal",
              "kJ"
            ],
            "title": "Unit"
          },
          "basis": {
            "$ref": "#/components/schemas/NutritionBasis"
          },
          "preparation": {
            "type": "string",
            "enum": [
              "as_sold",
              "as_prepared"
            ],
            "title": "Preparation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "row_id",
          "table_id",
          "nutrient",
          "value",
          "unit",
          "basis",
          "preparation"
        ],
        "title": "NutrientRow"
      },
      "NutritionBasis": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "quantity",
              "serving"
            ],
            "title": "Kind"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "g",
                  "mL"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "NutritionBasis"
      },
      "NutritionLookup": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1",
            "title": "Schema Version",
            "default": "1"
          },
          "nutrition_adapter_version": {
            "type": "string",
            "const": "1",
            "title": "Nutrition Adapter Version",
            "default": "1"
          },
          "requested_barcode": {
            "type": "string",
            "title": "Requested Barcode"
          },
          "product_barcode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Barcode"
          },
          "status": {
            "type": "string",
            "enum": [
              "found",
              "not_found",
              "rate_limited",
              "unavailable",
              "incompatible_response"
            ],
            "title": "Status"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "assessment_basis": {
            "type": "string",
            "const": "open_food_facts_community_data",
            "title": "Assessment Basis",
            "default": "open_food_facts_community_data"
          },
          "input_tables": {
            "items": {
              "$ref": "#/components/schemas/InputTableSource"
            },
            "type": "array",
            "title": "Input Tables"
          },
          "snapshot": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NutritionSnapshot"
              },
              {
                "type": "null"
              }
            ]
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "requested_barcode",
          "status",
          "source"
        ],
        "title": "NutritionLookup"
      },
