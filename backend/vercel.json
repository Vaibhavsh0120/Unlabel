{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "crons": [{"path": "/v1/notifications/dispatch", "schedule": "30 13 * * *"}],
  "functions": {
    "app/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,.env*,.venv/**,storage/runtime/**,__pycache__/**,*.log}"
    }
  }
}
