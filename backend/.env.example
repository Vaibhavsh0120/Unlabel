# Backend v0.1.0: public OFF reads require no key. Copy to ignored .env.
# Actual settings: identity, bounded network requests and exact website origins.
OFF_USER_AGENT="Unlabel/0.1.0 (https://github.com/Vaibhavsh0120/Unlabel)"
OFF_TIMEOUT_SECONDS=8
OFF_MAX_RESPONSE_BYTES=524288
# JSON array of exact origins. Add your real frontend origin after deployment.
CORS_ORIGINS=[]

# Reserved for a later version; v0.1.0 does not initialize or call AI.
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=
