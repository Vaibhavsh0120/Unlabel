# Every source is optional. Copy to ignored .env; no credentials are required to boot.
# Keyed sources use auto: a present key enables them; missing/empty keys disable them.
# Explicit false always disables a source. A key never proves live connectivity.
# Firebase-backed AI/live endpoints additionally require COMMUNITY_* credentials
# for authentication/quota state. Writes and private sync retain explicit opt-in.
# Restart the backend after changing this file. Never send keys to the frontend.
# OFF reads and the bundled local sources need no API key.
# Actual settings: identity, bounded network requests and exact website origins.
# OFF_USER_AGENT is derived from pyproject.toml unless explicitly overridden.
OFF_TIMEOUT_SECONDS=8
OFF_ENABLED=true
OFF_MAX_RESPONSE_BYTES=524288
# JSON array of exact origins. Add your real frontend origin after deployment.
CORS_ORIGINS=[]

# Optional immutable local index, resolved relative to backend/. Empty = inactive.
# Example after a successful import: storage/runtime/india
CATALOGUE_DIRECTORY=
CATALOGUE_ENABLED=true
RESEARCH_CATALOGUE_ENABLED=true
CLAIMS_ENABLED=true
GLOSSARY_ENABLED=true
# Hosted bundle uses app/catalogue/data and requires its build receipt.
# Local setup-generated runtime stores use false; do not modify a hosted bundle.
CATALOGUE_REQUIRE_RECEIPT=false

# Optional backend vision. One globally active slot serves all AI operations.
# Disabled without keys in a clean clone. Use scripts/ai/configure_ai.py.
AI_ENABLED=auto
GEMINI_ENABLED=true
OPENAI_ENABLED=true
# auto picks the first configured enabled slot (Gemini, OpenAI, replacements).
# The shared active selection remains sticky after initialization.
AI_INITIAL_CREDENTIAL_ID=auto
AI_FAILOVER_ENABLED=true
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_REQUEST_LIMIT=100
AI_ACTOR_DAILY_LIMIT=10
# Optional machine-only HTTP status/activation. Never send this to the app.
# AI_CONTROL_SECRET=<32-512 character random secret>
# Optional replacement slots: JSON array of id/provider/api_key/model objects.
# AI_FALLBACK_CREDENTIALS_JSON=[]

# Automatic public package observations: disabled in a clean clone.
# Public Firebase SDK settings are in firebase/client-config.json; they are not admin credentials.
COMMUNITY_ENABLED=false
# Optional personal profile/saved/history sync requires password Firebase login.
# Guests keep all personal data local; requires the configured community runtime.
ACCOUNT_SYNC_ENABLED=false
COMMUNITY_PROJECT_ID=unlabel-india-catalogue
COMMUNITY_DATABASE_ID=unlabel
# Set backend-only secrets locally or restore encrypted .env; never paste them into source.
# COMMUNITY_ACTOR_SECRET=<at least 32 random characters>
# COMMUNITY_SERVICE_ACCOUNT_JSON='<dedicated service-account JSON for this project>'

# Optional local reviewed-knowledge directory override, relative to backend/.
# Empty uses the generated deployment bundle or repository knowledge locally.
CLAIMS_KNOWLEDGE_DIRECTORY=

# Empty uses the generated researched-product database under app/research_catalogue/data.
RESEARCH_CATALOGUE_DIRECTORY=

# Optional live-only external facts. Requires the configured Firebase runtime above.
# The vendor enforces its account-wide allowance; the supplied sandbox grants 1,000 calls.
# These local caps are per process. Sandbox requests never renew by calendar date,
# but process restarts reset counters; track remaining vendor allowance across deployments.
# No vendor data enters catalogue/report storage; see docs/architecture/LIVE_PRODUCT_FACTS.md.
NUTRIGRAPH_ENABLED=auto
NUTRIGRAPH_API_KEY=
NUTRIGRAPH_MONTHLY_REQUEST_LIMIT=1000
NUTRIGRAPH_SANDBOX_REQUEST_LIMIT=1000
