# Inert planning template: no backend settings loader/application exists.
# Copy to ignored .env only when backend implementation begins.
# Hosted secrets are server settings; no keys/tokens belong in Flutter builds.
# No billing upgrade/card/trial requirement is allowed in the free baseline.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Optional PRIVATE local-development/tooling access only.
# Never embed this in an APK/web build or treat it as public authentication.
LOCAL_API_TOKEN=

# Rules/templates are mandatory; cloud wording is optional and off by default.
# Public AI requires verified individual adult-beta access + request bounds.
AI_PROVIDER=disabled
PUBLIC_AI_ENABLED=false
GEMINI_API_KEY=
# Select only after actual stable-model availability/free tier is checked.
GEMINI_MODEL=

# Local source path. Hosted runtime must use staged read-only JSON + manifest.
# The packaging step/path/settings loader remain to be implemented.
KNOWLEDGE_DIR=../knowledge
# Local laptop artifacts ONLY; /tmp and serverless memory are not durable.
RUNTIME_DIR=storage/runtime

# Future exact website origin allowlist; CORS is NOT authentication.
CORS_ALLOWED_ORIGINS=

# Optional enrichment; confirmed physical label remains the product source.
PRODUCT_LOOKUP_ENABLED=false
