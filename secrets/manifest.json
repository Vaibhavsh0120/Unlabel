{
  "schema_version": 1,
  "files": ["backend/.env", ".env", "frontend/.env", "frontend/android/key.properties"],
  "required": ["backend/.env"],
  "patterns": [
    ".env.*", "backend/.env.*", "frontend/.env.*",
    "frontend/android/*.jks", "frontend/android/*.keystore",
    "frontend/android/app/*.jks", "frontend/android/app/*.keystore",
    "backend/*service-account*.json", "backend/*service_account*.json"
  ],
  "directories": [
    "infrastructure/development/.secrets",
    "infrastructure/production/.secrets",
    "secrets/local"
  ]
}
